"WorldVertexTransition"
{
	"$basetexturetransform2" "center .5 .5 scale 1 1 rotate 30 translate 0 0"

	"$basetexture" "gm_construct/construct_sand"
	"$basetexture2" "maxofs2d/grass"
	"$blendmodulatetexture" "gm_construct/grass_blendmask"

	"$surfaceprop" "sand"
	"$surfaceprop2" "grass"

	// If there was a detailtransform, we could probably scroll the clouds
	"$detail" "gm_construct/grass_clouds"
	"$detailblendfactor" "0.5"
	"$detailscale" "0.12"
		"$detailtint" "0.75 1 0.75"
}